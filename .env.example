# URL BE local (profile "https" trong BE/src/API/Properties/launchSettings.json). Chỉ server Next đọc, không lộ ra browser.
BACKEND_URL=https://localhost:7000

# Dev only: Node không tin dev certificate của .NET nên proxy /api → BE báo lỗi chứng chỉ. Xoá dòng này khi BE dùng cert thật.
NODE_TLS_REJECT_UNAUTHORIZED=0
